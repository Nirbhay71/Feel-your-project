{
  "name": "feel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "db": "npm run db -w demo",
    "db:reset": "npm run db:reset -w demo",
    "demo": "concurrently -k -n api,web -c blue,green \"npm run server -w demo\" \"npm run dev -w demo\"",
    "pack": "node -e \"require('fs').mkdirSync('packs',{recursive:true})\" && npm pack -w @feel/agent -w @feel/client -w @feel/vite-plugin -w @feel/node --pack-destination packs",
    "test": "node --test"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
